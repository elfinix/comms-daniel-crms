# Supabase Configuration
SUPABASE_ID=your_supabase_project_id
SUPABASE_DB_PASS=your_supabase_database_password
SUPABASE_KEY=your_supabase_secret_key

# PostgreSQL Connection String (Session Mode Pooler)
DATABASE_URL=postgresql://postgres.your_supabase_project_id:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Django Application Security & Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
